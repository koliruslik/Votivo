# Copy to .env and replace password placeholders with unique random values.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_unique_random_password
POSTGRES_PORT=15432

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=replace_with_a_unique_random_password
RABBITMQ_PORT=15675
RABBITMQ_MGMT_PORT=25675

USER_SERVICE_PORT=18081
VOTE_SERVICE_PORT=18083

# Leave empty to let Vote Service answer from its static list of polls.
POLL_SERVICE_ADDR=

# Keycloak local development admin and published HTTP port.
# Bootstrap credentials apply when the initial admin is created.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=replace_with_a_unique_random_password
KEYCLOAK_PORT=18080

# Keycloak DB is created by postgres/init-databases.sh:
# database=keycloak_db, username=keycloak, password=keycloak.

# Resend SMTP: fill in your API key and an address on your verified domain.
# Applied during the initial realm import; existing realms are not updated.
RESEND_API_KEY=
SMTP_FROM=

# Set a unique client secret before the initial realm import.
KEYCLOAK_VOTIVO_USER_ADMI_SECRET=replace_with_a_unique_random_secret

# Realm configuration version imported into new Keycloak environments.
KEYCLOAK_REALM_VERSION=v1
