# Copy to .env and replace password placeholders with unique random values.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_unique_random_password
POSTGRES_PORT=15432

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=replace_with_a_unique_random_password
RABBITMQ_PORT=15675
RABBITMQ_MGMT_PORT=25675

USER_SERVICE_PORT=18081
POLL_SERVICE_PORT=18082
# Optional: build the standalone checkout instead of the services/user-service submodule.
# USER_SERVICE_BUILD_CONTEXT=C:/Users/Vovan/Desktop/Votivo-user-service
VOTE_SERVICE_PORT=18083
RESULT_SERVICE_PORT=18084
WEB_PORT=4200

# Shared by the web gateway and Poll, Vote and Result: they serve only calls that carry it in X-Internal-Auth.
# Generate with: openssl rand -hex 32
INTERNAL_AUTH_SECRET=replace_with_a_long_random_secret

# Keycloak local development admin and published HTTP port.
# Bootstrap credentials apply when the initial admin is created.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=replace_with_a_unique_random_password
KEYCLOAK_PORT=18080

# Keycloak DB is created by postgres/init-databases.sh:
# database=keycloak_db, username=keycloak, password=keycloak.

# Brevo SMTP: set the SMTP password and a verified sender address.
# Applied during the initial realm import; existing realms are not updated.
SMTP_FROM=

# Set a unique client secret before the initial realm import.
KEYCLOAK_VOTIVO_USER_ADMI_SECRET=replace_with_a_unique_random_secret
# Dedicated read-only machine client, shared by Keycloak initial import and User Service.
KEYCLOAK_USER_SERVICE_SYNC_SECRET=replace_with_another_unique_random_secret

# Realm configuration version imported into new Keycloak environments.
KEYCLOAK_REALM_VERSION=v8
SMTP_PASSWORD=

# RabbitMQ virtual host shared with the Keycloak event provider.
RABBITMQ_VHOST=/

# Separate client for profile updates, deletion and account blocking.
KEYCLOAK_USER_SERVICE_MANAGEMENT_SECRET=replace_with_a_unique_management_secret
