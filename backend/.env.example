# Copy to .env to override the defaults used by docker-compose.yml. Every value below is the default.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=15432

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=15675
RABBITMQ_MGMT_PORT=25675

USER_SERVICE_PORT=18081
VOTE_SERVICE_PORT=18083

# Leave empty to let Vote Service answer from its static list of polls.
POLL_SERVICE_ADDR=
